# Copy to .env for local development. Every variable is optional outside production.

# libSQL connection. Local dev and tests use a file; the live demo uses a hosted libsql:// URL
# (a file: URL is refused when VERCEL=1, because Vercel's filesystem is ephemeral).
DATABASE_URL=file:./data/app.db

# Required when DATABASE_URL is a libsql:// URL.
# DATABASE_AUTH_TOKEN=

# Signs the session cookie. Required (at least 32 characters) when NODE_ENV=production;
# development falls back to a fixed dev-only value.
# SESSION_SECRET=
